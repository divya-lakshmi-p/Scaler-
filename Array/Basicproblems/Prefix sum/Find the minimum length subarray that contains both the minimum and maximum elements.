Find the minimum length subarray that contains both the minimum and maximum elements.

o(n)

#include<bits/stdc++.h>
using namespace std;

void longarray(int arr[] , int n, int mini , int  maxi)
{  int big = -1;
  int small = -1 ,ans =n;
  for(int i=0; i<n; i++)
  { 
    if(arr[i] == mini)
    {
      small = i;

      if(big !=-1)
      {
        ans = min(ans , i-big+1);
      }

    }

    if(arr[i] == maxi)
    {
      big =i;

      if(small != -1)
      {
          ans = min(ans , i-small+1);
      }
    }
    
  }
  cout<<ans<<endl;
}

int main()
{
  int n;
  cin >> n;

  int arr[n];
  int maxi = INT_MIN , mini = INT_MAX;
  for(int i=0; i<n; i++)
  {
    cin >> arr[i];

    maxi = max(maxi , arr[i]);
    mini = min(mini , arr[i]);
  }

  if(mini == maxi)
  {
    cout<<1<<endl;
    return 0;
  }
  longarray(arr, n , mini,  maxi);
}

o(n^2)

#include<bits/stdc++.h>
using namespace std;

void longarray(int arr[] , int n, int mini , int  maxi)
{  int big = INT_MAX;
  for(int i=0; i<n; i++)
  {
    if(arr[i] == mini || arr[i] == maxi)
    {
      for(int j=i+1; j<n; j++)
      {
        if(arr[i] ==mini && arr[j]==maxi)
        {
             big = min(big , j-i+1);
             break;
        }
        else if(arr[i]== maxi && arr[j]==mini)
        {
          big = min(big , j-i+1);
          break;
        }
      }

    }
  }
  cout<<big<<endl;
}

int main()
{
  int n;
  cin >> n;

  int arr[n];
  int maxi = INT_MIN , mini = INT_MAX;
  for(int i=0; i<n; i++)
  {
    cin >> arr[i];

    maxi = max(maxi , arr[i]);
    mini = min(mini , arr[i]);
  }
  longarray(arr, n , mini,  maxi);
}
